{
  "name": "vision-e2e-showcase",
  "productName": "Vision E2E Showcase",
  "version": "1.11.1",
  "description": "Local-first E2E workbench with Electron, React, Playwright and MCP.",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "npm run build:panel",
    "start": "node scripts/electron-launcher.mjs .",
    "dev": "node scripts/dev.mjs",
    "web": "node scripts/web.mjs",
    "panel": "node scripts/web.mjs",
    "build:panel": "vite build",
    "release": "npm run build:panel && node scripts/build-release.mjs",
    "release:dir": "npm run build:panel && node scripts/build-release.mjs --dir",
    "release:mac": "npm run build:panel && node scripts/build-release.mjs --mac",
    "release:win": "npm run build:panel && node scripts/build-release.mjs --win",
    "runtime:run": "node runtime/server/cli.js",
    "runtime:server": "node runtime/server/http.js",
    "test": "node --test test/runtime/*.test.js",
    "perf:bench": "node scripts/perf-bench.js",
    "perf:report-size": "node scripts/perf-report-size.js",
    "perf:step-evidence": "node scripts/perf-step-evidence.js",
    "migrate:origins": "node scripts/migrate-origins.js",
    "demo": "node scripts/demo.cjs",
    "demo:serve": "node scripts/demo.cjs --serve",
    "check:privacy": "node scripts/check-public-snapshot.mjs",
    "check": "npm run check:privacy && npm run check:docs && npm test && npm run build:panel",
    "demo:board": "node scripts/demo-board.cjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:security": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [],
  "author": "topiniu",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "pdfkit": "^0.19.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.53.2",
    "pngjs": "^7.0.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tailwindcss/vite": "^4.2.1",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^5.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "electron": "^45.3.4",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-sortable-hoc": "npm:react-sortable-hoc-latest@^2.0.9",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topiniu/vision-e2e-showcase.git"
  },
  "bugs": {
    "url": "https://github.com/topiniu/vision-e2e-showcase/issues"
  },
  "homepage": "https://github.com/topiniu/vision-e2e-showcase#readme"
}
